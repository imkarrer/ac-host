{
  "uid": "ac-overview",
  "title": "ac-box + Dream Router",
  "timezone": "America/Chicago",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["ac-host", "unifi"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "ac-box CPU (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ac-box RAM",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ac-box root disk (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})",
          "legendFormat": "/"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ac-box load (56 threads)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1",
          "legendFormat": "1m"
        },
        {
          "refId": "B",
          "expr": "node_load5",
          "legendFormat": "5m"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lobby / sidecar CPU (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{id=~\".*docker-.*\"}[5m]) * on(id) group_left(container) docker_container_info)",
          "legendFormat": "{{ container }}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lobby / sidecar RAM",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{id=~\".*docker-.*\"} * on(id) group_left(container) docker_container_info)",
          "legendFormat": "{{ container }}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dream Router CPU (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (name) (unpoller_device_cpu_utilization_ratio{type=\"udm\"})",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Dream Router RAM (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (name) (unpoller_device_memory_utilization_ratio{type=\"udm\"})",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dream Router WAN",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(unpoller_device_wan_receive_bytes_total{name=\"Dream Router\"}[5m])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "expr": "rate(unpoller_device_wan_transmit_bytes_total{name=\"Dream Router\"}[5m])",
          "legendFormat": "out"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Dream Router WAN packets",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "pps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(unpoller_device_wan_receive_packets_total{name=\"Dream Router\"}[5m])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "expr": "rate(unpoller_device_wan_transmit_packets_total{name=\"Dream Router\"}[5m])",
          "legendFormat": "out"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "WAN / port-forward hits",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "pps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (chain) (rate(udr_firewall_packets_total{chain=~\"WAN_IN|WAN_LOCAL|WAN_PF_IN\"}[5m]))",
          "legendFormat": "{{ chain }}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Scrapes",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node\"}",
          "legendFormat": "node"
        },
        {
          "refId": "B",
          "expr": "up{job=\"cadvisor\"}",
          "legendFormat": "cadvisor"
        },
        {
          "refId": "C",
          "expr": "up{job=\"unpoller\"}",
          "legendFormat": "unpoller"
        },
        {
          "refId": "D",
          "expr": "up{job=\"udr-fw\"}",
          "legendFormat": "udr-fw"
        },
        {
          "refId": "E",
          "expr": "up{job=\"docker-names\"}",
          "legendFormat": "docker-names"
        }
      ]
    }
  ]
}
