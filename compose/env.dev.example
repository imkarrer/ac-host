# Dev stack — copy to /var/lib/ac-host-dev/.env
# Same secrets as prod are fine; status path must stay under /dev/.

AC_STATE=/var/lib/ac-host-dev
AC_CONTENT=/var/lib/ac-host/content
AC_PUBLIC_IP=127.0.0.1
AC_BOX_HOST=127.0.0.1
AC_BOX_USER=nixosuser
AUTH_OPEN=1
AUTH_REQUIRED_ROLE=ac-practice
AUTH_BIND=127.0.0.1:18081
STEAMCMD_LOGIN=anonymous
AC_ADMIN_PASSWORD=change-me
AC_GITHUB_OWNER=OWNER
AC_GITHUB_REPO=ac-practice
AC_PAGES_URL=https://OWNER.github.io/ac-practice/dev/
AC_CATALOG_STATICS=statics-dev.json
PLUGIN_SLOTS=8
GITHUB_STATUS_TOKEN=
GITHUB_STATUS_REPO=OWNER/ac-practice
GITHUB_STATUS_BRANCH=main
GITHUB_STATUS_PATH=dev/leaderboard.json
RENDER_SKIN_MODE=empty
# Leave UniFi off for LAN-only DEV unless you need WAN join to slot 8.
# UNIFI_PF=0
