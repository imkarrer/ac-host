# Parameterized env for one series server instance.
# Generated by: python scripts/acctl.py start-series …
# Or copy and edit for manual compose:
#   docker compose -f compose/docker-compose.yml -f compose/docker-compose.series.yml \
#     --env-file /var/lib/ac-host/.env --env-file /var/lib/ac-host/series/series-1/r00/quali/series.env \
#     --profile series up -d series-server

# Required (set by acctl start-series)
SERIES_CONTAINER_NAME=ac-series-series-1-r00-quali
SERIES_CFG_DIR=/var/lib/ac-host/series/series-1/rounds/r00/quali/cfg
SERIES_RESULTS_DIR=/var/lib/ac-host/series/series-1/rounds/r00/quali/results

# Metadata (informational; not used by compose)
SERIES_ID=series-1
SERIES_ROUND_ID=r00
SERIES_PHASE=quali
SERIES_MODE=quali-hotlap
SERIES_SLOT=4
SERIES_UDP=9604
SERIES_HTTP=8085
SERIES_TRACK=blackhawk
