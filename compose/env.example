# Copy to /var/lib/ac-host/.env (prod) or /var/lib/ac-host-dev/.env (dev).
# Never commit a real .env — it is gitignored.

# --- paths (NixOS box defaults) ---
AC_STATE=/var/lib/ac-host
AC_CONTENT=/var/lib/ac-host/content

# --- network identity (set these) ---
AC_PUBLIC_IP=127.0.0.1
AC_BOX_HOST=127.0.0.1
AC_BOX_USER=nixosuser

# --- auth / admin ---
AUTH_OPEN=1
AUTH_REQUIRED_ROLE=ac-practice
AUTH_BIND=127.0.0.1:18080
STEAMCMD_LOGIN=anonymous
AC_ADMIN_PASSWORD=change-me

# --- GitHub Pages / status push / 124 release ---
AC_GITHUB_OWNER=OWNER
AC_GITHUB_REPO=ac-practice
AC_PAGES_URL=https://OWNER.github.io/ac-practice/
# Optional override; default is releases/download/content/abarth_124_2016.zip on that repo
# AC_124_RELEASE_URL=
GITHUB_STATUS_TOKEN=
GITHUB_STATUS_REPO=OWNER/ac-practice
GITHUB_STATUS_BRANCH=main
GITHUB_STATUS_PATH=leaderboard.json

# --- monitoring (Grafana http://192.168.1.50:3000) ---
# Secrets live on the box only, not in this .env:
#   /var/lib/monitoring/secrets/unpoller.pass
#   /var/lib/monitoring/secrets/discord-webhook
# See monitoring/secrets.example

# --- UniFi Dream Router port forwards (off until UNIFI_PF=1) ---
# UNIFI_PF=0
# UNIFI_HOST=192.168.1.1
# UNIFI_USER=
# UNIFI_PASS=
# UNIFI_FWD_IP=127.0.0.1
# UNIFI_SITE=default
# UNIFI_WAN=wan

# --- optional ---
# Nightly practice recycle (America/Chicago). Aligns [PRACTICE] TIME, Discord
# #server-status countdown, and in-game chat. systemd timer must match this hour.
PRACTICE_RESTART_AT=03:00
AC_TZ=America/Chicago

# Open pits: cycle factory skins per car so joiners without a whitelist
# livery preference get different colors. GUID reservations still win first.
RENDER_SKIN_MODE=cycle
# 1 = appear in Kunos/CM public list (every CM client polls /INFO /JSON /api/details).
# 0 = join via player-page links only (recommended for whitelist practice).
REGISTER_TO_LOBBY=0
# --- Discord whitelist bot (optional; compose --profile bot) ---
# DISCORD_TOKEN=
# DISCORD_ADMIN_ROLE=ac-admin
# DISCORD_REVIEW_CHANNEL_ID=1545234424654991411
# DISCORD_STATUS_CHANNEL_ID=1545234415054225511
# DISCORD_VERIFY_PROFILE=1
# Public page: never-expire invite (setup_discord.py prints this) plus #welcome deep link.
# DISCORD_INVITE_URL=https://discord.gg/Rh7vevrUYy
# DISCORD_CHANNEL_URL=https://discord.com/channels/1544532113615749210/1545234414265700374
# DISCORD_FEATURE_REQUESTS_URL=https://discord.com/channels/1544532113615749210/1544893635353649294

