# Copy to compose/.env.buildkite (gitignored). Token is from
# https://buildkite.com → your org → Agents.
# Run this compose file on ac-box so jobs can see /var/lib/ac-host.
BUILDKITE_AGENT_TOKEN=
BUILDKITE_AGENT_NAME=ac-box
BUILDKITE_AGENT_TAGS=queue=self
# Optional: git clone of imkarrer/ac-practice for the pages job.
# Publishing the player page. Two routes; pick one.
#
# Contents API (preferred -- no clone on the box to drift):
#   leave AC_PAGES_CHECKOUT empty and set a token with contents:write on the
#   Pages repo. Same credential push_status.py uses for leaderboard.json.
# GITHUB_STATUS_TOKEN=ghp_...
# GITHUB_STATUS_REPO=imkarrer/ac-practice
# AC_PAGES_PUSH=1
#
# Git checkout (legacy):
# AC_PAGES_CHECKOUT=/var/lib/ac-host/pages
# AC_PAGES_PUSH=1

# --- MinIO Nix binary cache (loopback only; do not publish 9000/9001) ---
MINIO_ROOT_USER=ac-minio
MINIO_ROOT_PASSWORD=
S3_CACHE_BUCKET=flox-binary-cache
S3_CACHE_ENDPOINT=http://minio:9000
S3_CACHE_REGION=us-east-1
S3_CACHE_PUBLIC_KEY=flox-binary-cache-1:pSpP6x540XtBh+IMvmW8XrRHJDtIi+b31uvvIA0PyR0=
S3_CACHE_PUSH=true
S3_CACHE_ACCESS_KEY_ID=flox-cache
S3_CACHE_SECRET_ACCESS_KEY=
# Nix signing secret from `bash scripts/ci_nix_cache_key.sh`.
# Public half is .buildkite/flox-binary-cache.pub (committed).
S3_CACHE_SIGNING_KEY=
# Optional: local clone of the plugin instead of GitHub.
# FLOX_PLUGIN_CONTEXT=/path/to/flox-buildkite-plugin

# Lock bump into homelab (homelab's scripts/hub-bump-lock.sh, Part III row
# 24 in homelab/docs/architecture.md). On a green main build this pipeline
# triggers a homelab build that moves the `ac-host` input in flake.lock and
# pushes it, so a change to modules/ac-host.nix reaches the box without a
# hand-run `nix flake update`. A fine-grained token with contents:write on
# imkarrer/homelab ONLY -- not the pages token above, which is scoped to
# the pages repo. Leave unset and every trigger is a green no-op that says
# so; setting it is the step that makes a push here, three hops later, a
# system switch at 03:30.
# HOMELAB_PUSH_TOKEN=github_pat_...
