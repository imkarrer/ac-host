# Copy to compose/.env.buildkite (gitignored). Token is from
# https://buildkite.com → your org → Agents.
# Run this compose file on ac-box so jobs can see /var/lib/ac-host.
BUILDKITE_AGENT_TOKEN=
BUILDKITE_AGENT_NAME=ac-box
BUILDKITE_AGENT_TAGS=queue=self
# Optional: git clone of imkarrer/ac-practice for the pages job.
# AC_PAGES_CHECKOUT=/var/lib/ac-host/pages
# AC_PAGES_PUSH=1

# --- MinIO Nix binary cache (loopback only; do not publish 9000/9001) ---
MINIO_ROOT_USER=ac-minio
MINIO_ROOT_PASSWORD=
S3_CACHE_BUCKET=flox-binary-cache
S3_CACHE_ENDPOINT=http://minio:9000
S3_CACHE_REGION=us-east-1
S3_CACHE_PUBLIC_KEY=flox-binary-cache-1:pSpP6x540XtBh+IMvmW8XrRHJDtIi+b31uvvIA0PyR0=
S3_CACHE_PUSH=true
S3_CACHE_ACCESS_KEY_ID=flox-cache
S3_CACHE_SECRET_ACCESS_KEY=
# Nix signing secret from `bash scripts/ci_nix_cache_key.sh`.
# Public half is .buildkite/flox-binary-cache.pub (committed).
S3_CACHE_SIGNING_KEY=
# Optional: local clone of the plugin instead of GitHub.
# FLOX_PLUGIN_CONTEXT=/path/to/flox-buildkite-plugin
